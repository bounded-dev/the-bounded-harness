# Secrets — never commit
auth.json

# Runtime state
sessions/
models-store.json
bin/
missions/
run-history.jsonl

# Git worktrees of this repo (live harness checkouts)
.worktrees/

# Installed packages (restored by pi from settings.json "packages" list)
npm/
git/
node_modules/

# Stray lockfile from npm commands run at the wrong cwd (real lockfile: agent/package-lock.json)
/package-lock.json

# Local config overrides (API keys for third-party extensions)
web-search.json

# Tool-managed files — tools that want in write their own files, untracked
# (ADR 2026-006; e.g. Orca installs its extensions at runtime)
orca-*.ts

*.log
.DS_Store
.agent-state/
