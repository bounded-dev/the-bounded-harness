#!/usr/bin/env bash
# pi-harness-init — make a freshly cloned pi-harness live on this machine.
#
#   git clone git@github.com:bounded-dev/pi-harness.git
#   cd pi-harness && agent/scripts/pi-harness-init
#
# Does everything the README used to ask you to do by hand:
#
#   1. ~/.pi/agent            → this repo's agent/   (the live pi config home)
#   2. ~/.claude/CLAUDE.md    → agent/AGENTS.md      (Claude Code shares it)
#   3. the harness's commands onto PATH
#   4. npm ci, then the harness's own test suite
#
# Idempotent: safe to re-run after a pull, and re-running is how you pick up a
# newly added command. It never overwrites a real file — only its own symlinks,
# and it says so when it finds something in the way.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
AGENT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
REPO="$(cd -P "$AGENT/.." && pwd)"

# The commands this harness puts on PATH. Adding one here is all it takes —
# a contributor should not also have to remember to tell people to symlink it.
COMMANDS=(pi-ticket dogfood-reset pi-harness-init)

ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$1"; }

# Point `link` at `target`, but never clobber a real file or a foreign symlink.
link() {
  local target="$1" link="$2" what="$3"
  mkdir -p "$(dirname "$link")"
  if [ -L "$link" ]; then
    local current; current="$(readlink "$link")"
    if [ "$(readlink -f "$link" 2>/dev/null)" = "$(readlink -f "$target")" ]; then
      ok "$what already linked"; return
    fi
    warn "$what points elsewhere ($current) — leaving it alone"; return
  elif [ -e "$link" ]; then
    warn "$what exists and is a real file — leaving it alone, link it yourself if you meant to"
    return
  fi
  ln -s "$target" "$link"
  ok "$what → $target"
}

echo "pi-harness-init: $REPO"
echo
echo "Config home"
link "$AGENT" "$HOME/.pi/agent" "~/.pi/agent"
link "$AGENT/AGENTS.md" "$HOME/.claude/CLAUDE.md" "~/.claude/CLAUDE.md"

echo
echo "Commands"
# Pick the first writable PATH entry rather than assuming Homebrew: this has to
# work on a machine that is not this one.
BINDIR=""
for d in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin" "$HOME/bin"; do
  case ":$PATH:" in *":$d:"*) [ -w "$d" ] && { BINDIR="$d"; break; } ;; esac
done
if [ -z "$BINDIR" ]; then
  BINDIR="$HOME/.local/bin"
  mkdir -p "$BINDIR"
  warn "no writable PATH dir found — installed to $BINDIR; add it to your PATH"
fi
for cmd in "${COMMANDS[@]}"; do
  [ -f "$AGENT/scripts/$cmd" ] || { warn "$cmd missing from agent/scripts — skipped"; continue; }
  chmod +x "$AGENT/scripts/$cmd"
  # Through ~/.pi/agent, not the clone path, so the command tracks whatever the
  # config home points at rather than pinning one checkout.
  link "$HOME/.pi/agent/scripts/$cmd" "$BINDIR/$cmd" "$cmd"
done

echo
echo "Dependencies"
if [ -d "$AGENT/node_modules" ]; then
  ok "node_modules present (npm ci to refresh)"
else
  ( cd "$AGENT" && npm ci --silent >/dev/null 2>&1 ) && ok "npm ci" || warn "npm ci failed"
fi

echo
echo "Self-check"
if ( cd "$AGENT" && npm run check >/tmp/pi-harness-init-check.log 2>&1 ); then
  ok "$(grep -oE '[0-9]+ passed \([0-9]+\)' /tmp/pi-harness-init-check.log | tail -1) — harness is green"
else
  warn "npm run check FAILED — see /tmp/pi-harness-init-check.log"
  exit 1
fi

cat <<EOF

Ready. Available now:

  pi-ticket        start a pi session gated as the architect (one ticket)
  dogfood-reset    rebuild the two dogfood arms, ready to run

Re-run pi-harness-init after a pull to pick up newly added commands.
EOF
