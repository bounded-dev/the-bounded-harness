#!/usr/bin/env bash
# dogfood-reset — rebuild the two dogfood arms from scratch, ready to run.
#
#   dogfood-reset                     # both arms, the default prompt
#   dogfood-reset --harnessed         # ONLY the harnessed arm
#   dogfood-reset --bare              # ONLY the bare arm
#   dogfood-reset <prompt-file>       # any other prompt
#
# Reset one arm when the other is mid-run: a run dies for one-sided reasons
# (wrong model, a broken skill) far more often than for both at once, and
# wiping a healthy arm to restart a dead one throws away good data.
#
# Afterwards there is nothing to configure and no command to remember:
#
#   cd ~/dev/pi-harness-dogfood-bare        → run Claude Code
#   cd ~/dev/pi-harness-dogfood-harnessed   → run pi
#   …and paste the canonical prompt from docs/dogfood/ into either.
#
# The harnessed arm binds the architect role itself through
# `.pi/dev-stage-role`, so plain `pi` is gated — read anything, write only
# spec.md and *.contract.ts, no bash. Nothing to launch specially.
#
# Both arms get an identical operational AGENTS.md. The prompt lives ONLY in
# docs/dogfood/ — the arms carry no copy, so there is nothing to drift and
# nothing a reset can resurrect. Exactly one line differs between the arms,
# naming what that environment offers; that line is the whole experiment.
#
# Runs are DISPOSABLE, but never lost: an arm holding output is auto-archived
# to the run archive (branch `auto/<arm>-<timestamp>`) before it is wiped.
# Rename that branch later if the run turns out to be worth naming.

set -euo pipefail

# Overridable so the script can be exercised without destroying a live run.
BARE="${DOGFOOD_BARE:-$HOME/dev/pi-harness-dogfood-bare}"
HARNESSED="${DOGFOOD_HARNESSED:-$HOME/dev/pi-harness-dogfood-harnessed}"

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
AGENT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
HARNESS="$AGENT"
REPO="$(cd -P "$HARNESS/.." && pwd)"

WHICH=both
ARGS=()
for a in "$@"; do
  case "$a" in
    --harnessed) WHICH=harnessed ;;
    --bare)      WHICH=bare ;;
    --both)      WHICH=both ;;
    *)           ARGS+=("$a") ;;
  esac
done

PROMPT_SRC="${ARGS[0]:-$REPO/docs/dogfood/subscription-billing-prompt.md}"
[ -f "$PROMPT_SRC" ] || { echo "dogfood-reset: no prompt at $PROMPT_SRC" >&2; exit 2; }

# The canonical prompt carries an internal <!-- ... --> header explaining that
# it must not be edited. The arms must see only the prompt, so render a clean
# copy ONCE, next to the source, and point both arms at that.
RENDERED_PROMPT="$(dirname "$PROMPT_SRC")/.rendered-$(basename "$PROMPT_SRC")"
python3 - "$PROMPT_SRC" "$RENDERED_PROMPT" <<'PY'
import re, sys, pathlib
src, dst = sys.argv[1], sys.argv[2]
pathlib.Path(dst).write_text(
    re.sub(r"^<!--.*?-->\n\n", "", pathlib.Path(src).read_text(), flags=re.S))
PY

# The operational block is identical in both arms by construction: it is one
# string, written twice. An arm that quietly gained a different toolchain note
# or a different definition of done would confound the run silently.
read -r -d '' BLOCK <<'EOF' || true
# Working in this repo

## The project

A standalone TypeScript component. Nothing else depends on it yet, so the
public surface is yours to design.

- **Source** goes in `src/`, **tests** in `tests/`. Keep them separate.
- **Test runner:** vitest 4.1.11. **TypeScript:** 5.9.3, `strict`, plus
  `noUncheckedIndexedAccess` and `exactOptionalPropertyTypes` — the settings
  are in `tsconfig.json` and are not up for negotiation.
- **Commands:**
  - `npm run check` — `tsc --noEmit` then the full suite. This is the bar.
  - `npm test` — the suite alone.
- ESM, `NodeNext` resolution: intra-project imports need the `.js` extension
  (`import { x } from "./money.js"`) even though the file is `.ts`.
- Do not add dependencies. Everything needed is installed.
- Do not commit; leave your work in the working tree.

Done means `npm run check` passes: the suite is green **and** the project
typechecks.

## How work is done here
EOF

BARE_LINE='Nothing special. Build it with your ordinary tools, the way you think it
should be built.'
HARNESSED_LINE='This project is built through the **`developer-stage`** skill. Invoke it and
follow it.'

# A run is destroyed by the next reset, and "remember to archive first" is
# exactly the kind of instruction that gets skipped at 1am. So don't instruct:
# archive anything that looks like output, automatically, before wiping.
# Curate the branch name later; never lose the run.
autosave() {
  local dir="$1" arm="$2"
  [ -d "$dir" ] || return 0
  # Output = anything the agents wrote beyond the scaffolded baseline.
  if [ -f "$dir/spec.md" ] || [ -n "$(find "$dir/src" "$dir/tests" -name '*.ts' 2>/dev/null | head -1)" ]; then
    local name="auto/${arm}-$(date -u +%Y%m%dT%H%M%SZ)"
    echo "dogfood-reset: $arm arm has output — archiving to '$name' before wiping"
    "$(dirname "$0")/dogfood-archive" "$name" --arm "$arm" \
      -m "Auto-archived by dogfood-reset before wiping the $arm arm." \
      || echo "dogfood-reset: WARNING — archive failed; the arm was NOT wiped" >&2
  fi
}

scaffold() {
  local dir="$1" line="$2"
  local arm; case "$dir" in *harnessed*) arm=harnessed ;; *) arm=bare ;; esac
  autosave "$dir" "$arm" || return 1
  rm -rf "$dir"
  mkdir -p "$dir/src" "$dir/tests"

  cat > "$dir/package.json" <<'EOF'
{
  "name": "dogfood",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
EOF

  cat > "$dir/tsconfig.json" <<'EOF'
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
EOF

  printf '%s\n%s\n' "$BLOCK" "$line" > "$dir/AGENTS.md"
  # No PROMPT.md in the arms: the user pastes from the one canonical rendered
  # prompt in docs/dogfood/. A per-arm copy (or symlink) was one more thing to
  # keep identical, and deleting it here without deleting it there meant every
  # reset resurrected it.
  printf 'node_modules/\n' > "$dir/.gitignore"
  touch "$dir/src/.gitkeep" "$dir/tests/.gitkeep"

  ( cd "$dir" && npm install --silent >/dev/null 2>&1 )
  ( cd "$dir" && git init -q && git add -A \
      && git commit -q -m "Baseline: empty TypeScript project + prompt" )
}

# A skill whose frontmatter will not parse does not error — it vanishes from
# the session's skill list, and the agent improvises the pipeline from memory.
# That voided a live arm on 2026-09-02. Check before handing over two arms.
if [ "$WHICH" != "bare" ]; then
  if ! ( cd "$AGENT" && npx vitest run src/skill-frontmatter.test.ts >/dev/null 2>&1 ); then
    echo "dogfood-reset: FATAL — a skill's frontmatter is malformed, so pi will" >&2
    echo "  silently drop it and the harnessed arm will run without its pipeline." >&2
    echo "  Run: cd $AGENT && npx vitest run src/skill-frontmatter.test.ts" >&2
    exit 1
  fi
fi

echo "dogfood-reset: rebuilding ${WHICH} from $PROMPT_SRC"
[ "$WHICH" = "harnessed" ] || scaffold "$BARE" "$BARE_LINE"
if [ "$WHICH" != "bare" ]; then
  scaffold "$HARNESSED" "$HARNESSED_LINE"
  # Only the harnessed arm is gated. The role is read from this file at session
  # start, so a plain `pi` in this directory IS the architect — no launcher, no
  # flag, nothing to remember.
  mkdir -p "$HARNESSED/.pi"
  printf 'architect\n' > "$HARNESSED/.pi/dev-stage-role"
  ( cd "$HARNESSED" && git add -A && git commit -q --amend --no-edit )
fi

# Guard the property the comparison rests on. The prompt lives only in
# docs/dogfood/ now — the arms carry no copy, so prompt identity is structural.
# Verify the canonical rendered prompt exists and is non-empty, since pasting
# from a missing file hands an arm nothing at all.
[ -s "$RENDERED_PROMPT" ] || { echo "dogfood-reset: FATAL — $RENDERED_PROMPT missing or empty" >&2; exit 1; }
if [ -d "$BARE" ] && [ -d "$HARNESSED" ]; then
  if ! diff -q <(sed '/^## How work is done here$/q' "$BARE/AGENTS.md") \
               <(sed '/^## How work is done here$/q' "$HARNESSED/AGENTS.md") >/dev/null; then
    echo "dogfood-reset: FATAL — operational blocks differ between arms" >&2; exit 1
  fi
fi

cat <<EOF

Both arms ready. Operational blocks verified identical.

  cd $BARE
      run Claude Code
  cd $HARNESSED
      run pi                (gated as the architect automatically)

  Paste the prompt from: $RENDERED_PROMPT

Runs are disposable — re-run dogfood-reset to start over.
EOF
