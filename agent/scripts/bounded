#!/usr/bin/env bash
# bounded — the Bounded Harness CLI. One command, subcommands for everything:
#
#   bounded init                    # make a fresh clone live on this machine
#   bounded gates <gate> [dir]      # run one artifact gate (bounded gates --list)
#   bounded ticket                  # start a session bound to the ARCHITECT role
#   bounded change-run [dir]\n#   bounded adopt [--cwd dir]\n#   bounded change-diff [--cwd dir]        # open the run boundary for a change run
#   bounded dogfood-reset           # rebuild both dogfood arms
#   bounded dogfood-archive <name>  # archive a dogfood arm's run
#
# Each subcommand is its own script beside this one; this file only routes.
# The vision (TN-26-007): install the bounded CLI, type `bounded init`, and
# the harness wires itself into every agent framework it supports.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPTS="$(cd -P "$(dirname "$SOURCE")" && pwd)"

usage() {
  sed -n '2,13p' "$SCRIPTS/bounded" | sed 's/^# \{0,1\}//'
}

SUB="${1:-}"
case "$SUB" in
  init)            shift; exec "$SCRIPTS/bounded-init" "$@" ;;
  compose)         shift; exec node "$SCRIPTS/../packs/compose.ts" "$@" ;;
  adopt|change-diff|capture-baseline) shift; exec node "$SCRIPTS/../packs/command.ts" "$SUB" "$@" ;;
  gates)           shift; exec "$SCRIPTS/bounded-gates" "$@" ;;
  ticket)          shift; exec "$SCRIPTS/bounded-ticket" "$@" ;;
  change-run)      shift; exec "$SCRIPTS/bounded-change-run" "$@" ;;
  dogfood-reset)   shift; exec "$SCRIPTS/dogfood-reset" "$@" ;;
  dogfood-archive) shift; exec "$SCRIPTS/dogfood-archive" "$@" ;;
  -h|--help|help|"") usage; [ -n "$SUB" ]; exit $? ;;
  *) echo "bounded: unknown subcommand '$SUB'" >&2; echo >&2; usage >&2; exit 64 ;;
esac
